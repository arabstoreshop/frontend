# API URL (GitHub Pages build + EasyPanel frontend)
# GitHub Pages static export MUST bake this at build time:
# STATIC_EXPORT=true NEXT_PUBLIC_API_URL=https://api.naseem.beauty npm run build
NEXT_PUBLIC_API_URL=https://api.naseem.beauty
NEXT_PUBLIC_ADMIN_API_URL=https://api.naseem.beauty
# Same Sukoon Apps Script. If the API is down, checkout still writes tab "nassim order".
NEXT_PUBLIC_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxTidbmqTr6dKV7lOEmlQBR81R_Sv-VF8AA7UerWzvJ0wWd8pT5QtyyA9NlOGU7WLE9YQ/exec
# Optional SHA-256 of the admin password. Default hash is already in the app.
NEXT_PUBLIC_ADMIN_PASS_HASH=

# Optional fallback if API is down. Prefer setting pixel IDs on EasyPanel backend.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
